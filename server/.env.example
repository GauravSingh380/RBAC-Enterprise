NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Release / build recorded on production errors (default: package.json version)
APP_VERSION=
# Local only: true turns off the per-IP rate limits (e.g. for repeated Postman runs). Ignored in production.
RATE_LIMIT_DISABLED=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=team-flex

# Auth (generate a long random secret for JWT_SECRET)
JWT_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Logging (levels: error, warn, info, http, verbose, debug)
LOG_LEVEL=http
LOG_DIR=logs
LOG_HTTP_BODIES=true
LOG_MAX_BODY_LENGTH=4000
LOG_SLOW_REQUEST_MS=1000
LOG_SQL=true
LOG_SQL_CONSOLE=true
LOG_SQL_PARAMS=true
LOG_SLOW_QUERY_MS=200

# Email (outbox = view emails in Platform → Mailbox; ethereal = free fake SMTP with preview links;
# smtp = real provider e.g. Brevo free tier / Gmail app password — then @yopmail.com inboxes receive mail)
EMAIL_DRIVER=outbox
EMAIL_FROM=Team-Flex <no-reply@teamflex.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Background jobs (worker runs inside the API process)
JOBS_ENABLED=true
JOBS_CONCURRENCY=2
JOBS_POLL_INTERVAL_MS=1000
# Delay before an instant notification email (skipped if read in the app meanwhile)
NOTIFY_EMAIL_DELAY_SECONDS=60

# File uploads (attachments)
STORAGE_DIR=uploads
MAX_UPLOAD_MB=10
